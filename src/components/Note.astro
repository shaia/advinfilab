---
/** A handwritten margin note: asides, warnings, "notice that…". */
interface Props {
  kind?: 'note' | 'warn';
  /** an anchor a misconception remedy can link to */
  id?: string;
}
const { kind = 'note', id } = Astro.props;
---

<aside class={`note hand note-${kind}`} id={id}><slot /></aside>
